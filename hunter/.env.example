# --- Signhify Hunter environment ---
# Copy to .env and fill what you have. Everything works without keys:
# agents run in sandbox mode (no real sends, no external calls beyond public feeds).

# Public data feeds (no key needed for HN / Reddit)
HUNTER_SITE_URL="http://localhost:3001"

# LLM (optional — enables AI scoring / personalization / reply classification)
# OpenAI
HUNTER_OPENAI_API_KEY=""
# Anthropic (used if OPENAI key absent)
HUNTER_ANTHROPIC_API_KEY=""
HUNTER_LLM_MODEL="gpt-4o-mini"

# Email delivery (optional — without it, sends are simulated in sandbox mode)
HUNTER_RESEND_API_KEY=""
HUNTER_FROM_EMAIL="hunter@signhify.dev"
HUNTER_FROM_NAME="Piyush — Signhify Studio"

# Physical postal address required by CAN-SPAM (rendered in every email footer)
HUNTER_PHYSICAL_ADDRESS="Signhify, Bihar, India"

# Scout adapters (optional tokens — adapters degrade gracefully without them)
HUNTER_GITHUB_TOKEN=""
HUNTER_PRODUCTHUNT_TOKEN=""

# Sending safety (sandbox default: messages are created but never leave the system)
HUNTER_SANDBOX="true"
# Scheduler interval in seconds
HUNTER_SCHEDULE_INTERVAL_SEC="30"
# Port for dev server
PORT="3001"
