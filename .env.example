# ──────────────────────────────────────────────────────────
# Signhify — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_ANON_KEY="your-anon-key"

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STUDIO_PRICE_ID="price_..."
STRIPE_SCALE_PRICE_ID="price_..."
STRIPE_CREDIT_PACK_PRICE_ID="price_..."

# ── Cloudflare (for user-facing project deployments) ──────
CLOUDFLARE_API_TOKEN="your-api-token"
CLOUDFLARE_ACCOUNT_ID="your-account-id"

# ── Site URL ──────────────────────────────────────────────
# Used by server functions (checkout, portal, subscribe, etc.)
VITE_SITE_URL="https://signhify.dpdns.org"

# ── App Secrets ───────────────────────────────────────────
# AES-256-GCM key for encrypting user AI keys and env secrets
SECRETS_MASTER_KEY="your-32-byte-hex-key"

# ── AI / Lovable ──────────────────────────────────────────
LOVABLE_API_KEY="your-lovable-api-key"

# ── Testing ───────────────────────────────────────────────
# Override the target URL for Playwright tests
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# ── Optional ──────────────────────────────────────────────
# NODE_ENV is set automatically by the runtime (Vite/Nitro)
# SENTRY_DSN=""  # Not yet configured
